                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "gENaC",
                              "fill": "#0F172A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Sertraline 50mg titrated up 2 weeks ago, with modest mood improvement and GI side-effects subsiding. Sleep latency averaging 45 min, with onset between 23:30-01:30. HR variability suggests elevated baseline arousal under work stress.",
                              "lineHeight": 1.6,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "fyY6u",
                              "fill": "#0F766E",
                              "content": "PSYCHOLOGICAL",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "700",
                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "L2Y09",
                              "fill": "#0F172A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Trauma-linked hyperarousal continues to drive avoidance of evening transitions. Compulsive phone scrolling as self-soothing maintains the sleep-anxiety loop. Gratitude practice is becoming a real anchor (87% adherence).",
                              "lineHeight": 1.6,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "JQrq6",
                              "fill": "#0F766E",
                              "content": "SOCIAL",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "700",
                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "xZj17",
                              "fill": "#0F172A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Work pressure peaking on a quarterly cycle — pattern matches prior sleep deterioration episodes. Single roommate (Mia) supportive but not aware of treatment. Recent shift in close-friend dynamics may be re-activating attachment-related vigilance.",
                              "lineHeight": 1.6,
