                    {
                      "type": "text",
                      "id": "GM9kf",
                      "name": "h",
                      "fill": "#0F172A",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your privacy & confidentiality",
                      "fontFamily": "Inter",
                      "fontSize": 15,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "Lx2UW",
                  "name": "p1",
                  "fill": "#334155",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Protecting the confidentiality of your health information is central to how the platform is built and operated. We are committed to handling all personal and protected health information in a manner consistent with the standards established under the U.S. Health Insurance Portability and Accountability Act of 1996 (HIPAA), and we are actively working toward full HIPAA compliance across our systems, processes, and third-party integrations.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "AroV8",
                  "name": "p2",
                  "fill": "#334155",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Access to patient data is strictly limited to authorized personnel on a need-to-know basis, but rest assured — every individual involved in the development, operation, or maintenance of the platform is required to complete a thorough vetting process, including successful completion of a Level 2 background screening. All such personnel are bound by confidentiality obligations and receive regular training and briefings that reinforce the critical importance of safeguarding patient information.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
